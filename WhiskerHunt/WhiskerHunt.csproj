<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>WhiskerHunt</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Hush Hunt</ApplicationTitle>
    <ApplicationId>uk.whiskerhunt.mobile</ApplicationId>
    <ApplicationDisplayVersion>3.10.59</ApplicationDisplayVersion>
    <ApplicationVersion>124</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <XamarinGoogleGuavaListenableFutureOptOut>true</XamarinGoogleGuavaListenableFutureOptOut>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <!-- MAUI-compatible bindings for native Google Play Services for AR; Android only. -->
    <PackageReference Include="XPACE.Google.ARCore" Version="1.41.0" />
    <!-- Native Google Filament/gltfio: published together on Maven Central (1.77.3, Oct 2026). -->
    <!-- Bound=false: Java bridge avoids generating hundreds of redundant C# bindings. -->
    <AndroidMavenLibrary Include="com.google.android.filament:filament-android" Version="1.77.3" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.android.filament:gltfio-android" Version="1.77.3" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="androidx.annotation:annotation" Version="1.9.1" Repository="Google" Bind="false" VerifyDependencies="false" />
    <MauiIcon Include="Resources\AppIcon\hushhunt_bunny_v63.png" Color="#0765DC" />
    <MauiSplashScreen Include="Resources\Splash\hushhunt_bunny_splash_v63.png" Color="#0765DC" BaseSize="256,256" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Ensure the JNI entry point is compiled into classes.dex. A metadata-only Update
         can leave this application without the renderer class when no Java item
         exists in the evaluated MAUI project. Remove the default item first to
         avoid duplicate Java source entries on .NET SDKs with implicit globs. -->
    <AndroidJavaSource Remove="Platforms\Android\Java\com\hushhunt\filament\HushFilamentOverlay.java" />
    <AndroidJavaSource Include="Platforms\Android\Java\com\hushhunt\filament\HushFilamentOverlay.java" Bind="false" />
    <!-- HUSH_31059_LIVE_HAND_PET -->
    <!-- MediaPipe: explicitly include the transitive Java artifacts. AndroidMavenLibrary
         does NOT bring in dependencies automatically in .NET for Android. -->
    <AndroidMavenLibrary Include="com.google.mediapipe:tasks-vision" Version="0.10.35" Repository="Google" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.mediapipe:tasks-core" Version="0.10.35" Repository="Google" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.guava:guava" Version="27.0.1-android" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.flogger:flogger" Version="0.6" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.flogger:flogger-system-backend" Version="0.6" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.protobuf:protobuf-javalite" Version="4.26.1" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.android.datatransport:transport-api" Version="3.0.0" Repository="Google" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.android.datatransport:transport-backend-cct" Version="3.1.0" Repository="Google" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.android.datatransport:transport-runtime" Version="3.1.0" Repository="Google" Bind="false" VerifyDependencies="false" />
    <AndroidJavaSource Remove="Platforms\Android\Java\com\hushhunt\filament\HushLiveHandTracker.java" />
    <AndroidJavaSource Include="Platforms\Android\Java\com\hushhunt\filament\HushLiveHandTracker.java" Bind="false" />
  </ItemGroup>
  <!-- Hush Hunt v3.10.59h: omit duplicate Java ListenableFuture assets; retain full Guava. -->
  <ItemGroup>
    <PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="1.0.0.29" ExcludeAssets="all" />
  </ItemGroup>
  <!-- HUSH_31059K_JAVAX_INJECT_RUNTIME: supply javax.inject.Provider required by MediaPipe DataTransport. -->
  <ItemGroup>
    <AndroidMavenLibrary Include="javax.inject:javax.inject" Version="1" Bind="false" VerifyDependencies="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- v3.10.59l: DataTransport CCT 3.1.0 dependencies (MediaPipe hand tracking) -->
    <AndroidMavenLibrary Include="com.google.firebase:firebase-encoders" Version="17.0.0" Repository="Google" Bind="false" VerifyDependencies="false" />
    <AndroidMavenLibrary Include="com.google.firebase:firebase-encoders-json" Version="18.0.0" Repository="Google" Bind="false" VerifyDependencies="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hush Hunt v3.10.59n: protobuf encoder for DataTransport background uploader -->
    <AndroidMavenLibrary Include="com.google.firebase:firebase-encoders-proto" Version="16.0.0" Repository="Google" Bind="false" VerifyDependencies="false" />
  </ItemGroup>
</Project>
