<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>WhiskerHunt</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Whisker Hunt</ApplicationTitle>
    <ApplicationId>uk.whiskerhunt.mobile</ApplicationId>
    <ApplicationDisplayVersion>3.3.0</ApplicationDisplayVersion>
    <ApplicationVersion>35</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#231B3F" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#231B3F" BaseSize="256,256" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
